{
  "manifest_version": 3,
  "name": "YouTube Inline Fullscreen",
  "version": "1.3.10",
  "description": "Make the most out of your screen space with a single click!",

  "icons": {
    "16": "icons/fullscreen-16.png",
    "48": "icons/fullscreen-48.png",
    "128": "icons/fullscreen-128.png"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "*://*.youtube.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "ytif_style.css"
      ],
      "js": [
        "ytif_content_script.js"
      ]
    }
  ],

  "action": {
    "default_title": "YouTube Inline Fullscreen",
    "default_icon": {
      "16": "icons/fullscreen-16.png",
      "48": "icons/fullscreen-48.png",
      "128": "icons/fullscreen-128.png"
    },
    "default_popup": "settings/settings.html"
  }
}
