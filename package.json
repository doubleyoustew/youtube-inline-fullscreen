{
  "name": "youtube-inline-fullscreen",
  "version": "1.4.1",
  "description": "Make the most out of your screen space with a single click!",
  "scripts": {
    "sass": "sass app:app",
    "sass:watch": "sass --watch app:app",
    "build:settings": "npx @tailwindcss/cli -i app/settings/style/src/style.css -o app/settings/style/dist/style.css",
    "build:settings:watch": "npx @tailwindcss/cli -i app/settings/style/src/style.css -o app/settings/style/dist/style.css --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/check-defaults.mjs"
  },
  "author": "doubleyoustew",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "daisyui": "^5.0.46",
    "tailwindcss": "^4.2.4",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
